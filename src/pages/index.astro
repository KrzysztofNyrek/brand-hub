---
// Root strony startowej.
// Domyślny build (HUB_LANG nieustawiony) → EN na „/" + PL na „/pl/".
// Build .pl (HUB_LANG=pl) → „/" = PL (deploy do osobnego projektu CF Pages). Patrz README.
import HubHome from '../components/HubHome.astro';
const lang = process.env.HUB_LANG === 'pl' ? 'pl' : 'en';
---
<HubHome lang={lang} />
