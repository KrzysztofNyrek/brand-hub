---
// HERO — Design System KN (D79). Obietnica pomostowa + kim jest + 2 CTA + portret.
// Copy (h1, who, tag, CTA) — VERBATIM; zmienia się TYLKO warstwa wizualna (re-skin).
const { lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
const c = isPl
  ? {
      ctaA: 'Zautomatyzuj mój biznes',
      ctaB: 'Naucz mnie AI w pracy',
      who: 'Od ponad dwóch dekad prowadzę projekty, na co dzień mapuję procesy i wdrażam automatyzacje. Nie jestem guru i nie sprzedaję marzeń.',
      tag: 'Nie sprzedaję marzeń. Sprzedaję nudną, techniczną automatyzację, która działa.',
    }
  : {
      ctaA: 'Get it built for you',
      ctaB: 'Learn to build it yourself',
      who: 'Two decades of running projects, author of Project Coffee, Prince2 and AgilePM certified.',
      tag: 'No guru. Just a practitioner who tests this stuff and shows you the receipts.',
    };
---
<section id="hero" class="section-pad hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      {isPl ? (
        <h1 class="h-hero">Automatyzuję to, co w Twojej firmie robi się ręcznie co tydzień i mówię wprost, gdzie AI pomaga, a gdzie <span class="accent-italic">tylko udaje</span>.</h1>
      ) : (
        <h1 class="h-hero">I'm a project manager who <span class="accent-italic">runs on AI</span>, and I'll tell you straight where it works and where it falls flat.</h1>
      )}
      <p class="body-lg hero-who">
        <strong style="font-weight:600;">Krzysztof Nyrek.</strong> {c.who}
      </p>
      <p class="hero-tag">{c.tag}</p>
      <div class="hero-cta">
        <a class="btn-primary" href="#automation">{c.ctaA}</a>
        <a class="btn-secondary" href="#learn">{c.ctaB}</a>
      </div>
    </div>

    <figure class="hero-figure">
      <div class="portrait-card">
        <picture>
          <source srcset="/portrait-krzysztof.webp" type="image/webp" />
          <img src="/portrait-krzysztof.jpg" width="1200" height="1589" alt="Krzysztof Nyrek" fetchpriority="high" decoding="async" />
        </picture>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero { padding-top: var(--space-3xl); }
  .hero-grid { display: grid; gap: var(--space-2xl); align-items: center; }
  .hero-copy { min-width: 0; }

  .h-hero { margin-bottom: var(--space-lg); }
  .hero-who { color: var(--text-muted); max-width: 46ch; margin: 0 0 var(--space-md); }
  /* tagline edytorski — muted, lewy navy akcent (bez mono `//`) */
  .hero-tag {
    max-width: 44ch; margin: 0 0 var(--space-xl);
    color: var(--text-muted); font-size: var(--fs-body);
    padding-left: var(--space-md); border-left: 2px solid var(--navy-200);
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-md); }

  /* PORTRET — czysta karta DS: white, hairline navy, radius-lg, miękka chłodna desaturacja */
  .hero-figure { margin: 0; justify-self: center; max-width: 380px; width: 100%; }
  .portrait-card {
    background: var(--color-panel);
    border: 1px solid var(--navy-200);
    border-radius: var(--radius-lg);
    padding: 10px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .portrait-card img {
    width: 100%; display: block;
    border-radius: calc(var(--radius-lg) - 4px);
    filter: saturate(0.6) contrast(1.02) brightness(1.02);
  }

  @media (min-width: 880px) {
    .hero-grid { grid-template-columns: 1.12fr 0.88fr; gap: var(--space-4xl); }
    .hero-figure { justify-self: end; max-width: 400px; }
  }
</style>
