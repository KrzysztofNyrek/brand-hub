---
// Kompozycja strony startowej — składa sekcje wg języka (spec §4A EN / §4B PL).
// EN: 6 sekcji (Hero, Doors, Authority, About, Blog, Contact).
// PL: lżejszy (spec §4B) — bez teasera bloga.
import Hub from '../layouts/Hub.astro';
import Hero from './Hero.astro';
import Doors from './Doors.astro';
import Authority from './Authority.astro';
import Toolkit from './Toolkit.astro';
import AboutTeaser from './AboutTeaser.astro';
import BlogTeaser from './BlogTeaser.astro';
import Contact from './Contact.astro';

const { lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
const meta = isPl
  ? {
      title: 'Krzysztof Nyrek · project manager i gotowce dla PM',
      description: 'Ponad dwie dekady prowadzenia projektów. Oddaję gotowce, których sam używam, kiedy projekt się pali, i pokazuję, gdzie AI naprawdę pomaga w pracy PM.',
    }
  : {
      title: 'Krzysztof Nyrek · a project manager who runs on AI',
      description: 'I build automation systems for businesses, and I teach project managers to use AI in their own work. A practitioner, not a guru.',
    };
---
<!--
  KOLEJNOŚĆ SEKCJI RÓŻNI SIĘ MIĘDZY JĘZYKAMI I TO JEST ŚWIADOME (D118 pkt 4).
  PL: tożsamość project managera i produkt PM na górze, automatyzacja (Doors) na dole,
  bo automatyzacja jest ostatnim etapem ścieżki klienta (D117 pkt 4), nie wejściem.
  EN (.eu, archiwum wg D118 pkt 10): układ bez zmian.
-->
<Hub lang={lang} title={meta.title} description={meta.description}>
  <Hero lang={lang} />
  {isPl && <Toolkit lang={lang} />}
  {isPl ? (
    <Fragment><Authority lang={lang} /><Doors lang={lang} /></Fragment>
  ) : (
    <Fragment><Doors lang={lang} /><Authority lang={lang} /></Fragment>
  )}
  <AboutTeaser lang={lang} />
  {!isPl && <BlogTeaser />}
  <Contact lang={lang} />
</Hub>
