---
// KONTAKT (spec §4A/§4B sekcja 6). Mail + LinkedIn. Stopka jest w Hub.astro.
import { LINKS } from '../config.mjs';
const { lang = 'en' } = Astro.props;
const isPl = lang === 'pl';
const t = isPl
  ? { head: 'Pogadajmy', copy: 'Masz proces, który zjada Ci tydzień, albo pytanie o to całe AI? Napisz. Czytam wszystko sam.', li: 'LinkedIn' }
  : { head: 'Let’s talk', copy: 'Got a process that’s eating your week, or a question about the AI stuff? Write to me. I read everything myself.', li: 'LinkedIn' };
---
<section id="contact" class="section-pad contact">
  <div class="container contact-inner">
    <h2 class="h2">{t.head}</h2>
    <p class="body-lg contact-copy">{t.copy}</p>
    <div class="contact-links">
      <a class="btn-primary" href={`mailto:${LINKS.mail}`}>{LINKS.mail}</a>
      {LINKS.linkedin
        ? <a class="link contact-li" href={LINKS.linkedin}>{t.li} →</a>
        : <a class="link contact-li" href="#" data-todo="linkedin-profile" title={isPl ? 'URL LinkedIn do dostarczenia (P2)' : 'LinkedIn URL — to be supplied (P2)'}>{t.li} →</a>}
    </div>
  </div>
</section>

<style>
  .contact-inner { max-width: var(--maxw-prose); }
  .contact-copy { margin: var(--space-md) 0 var(--space-xl); color: var(--text-muted); }
  .contact-links { display: flex; flex-wrap: wrap; gap: var(--space-lg); align-items: center; }
  .contact-li { font-weight: 600; }
</style>
