---
// Brand Hub — shared layout. Sticky NAV + flaga PL/EN + stopka + hreflang.
// Prop `lang` ('en'|'pl') steruje nawigacją, flagą i copy stopki. Ta sama identity
// (tokens.css — Design System KN, D79) dla obu; różni się układ/treść sekcji.
import '../styles/tokens.css';
import { HUB_EN, HUB_PL } from '../config.mjs';
import Consent from '../components/Consent.astro';

const { lang = 'en', title, description, canonical: canonicalProp, ogType = 'website', ogImage, noHreflang = false } = Astro.props;
const isPl = lang === 'pl';
const canonical = canonicalProp || (isPl ? HUB_PL + '/' : HUB_EN + '/');

const nav = isPl
  ? {
      links: [
        { href: '/#toolkit', label: 'PM Crisis Toolkit' },
        { href: '/interwencja', label: 'Interwencja' },
        { href: '/blog', label: 'Blog' },
        { href: '/#automation', label: 'Automatyzacja' },
        { href: '/#about', label: 'O mnie' },
      ],
      flagHref: HUB_EN, flagLabel: 'EN',
      cta: { href: '/#contact', label: 'Kontakt' },
    }
  : {
      links: [
        { href: '/#automation', label: 'Automation' },
        { href: '/#learn', label: 'Learn AI' },
        { href: '/blog', label: 'Blog' },
        { href: '/#about', label: 'About' },
      ],
      flagHref: HUB_PL, flagLabel: 'PL',
      cta: { href: '/#contact', label: 'Contact' },
    };

const footer = isPl
  ? {
      tagline: 'Krzysztof Nyrek · Prowadzenie projektów, oparte na praktyce.',
      altHref: HUB_EN, altLabel: 'English',
      home: 'Wróć na górę',
      privacy: 'Polityka prywatności',
      terms: 'Regulamin sprzedaży',
      // Zwroty w stopce, a nie tylko przy przycisku zakupu: kupujący szuka ich zwykle
      // POST factum, czyli wtedy, gdy nie ma już przed oczami strony sprzedaży (K, 20.08).
      returns: 'Polityka zwrotów',
      ai: 'Jak powstają te teksty',
    }
  : {
      tagline: 'Krzysztof Nyrek · Project management, run on AI.',
      altHref: HUB_PL, altLabel: 'Polski',
      home: 'Back to top',
      // Dokument jest polski i taki zostaje (RODO wymaga dostępności i zrozumiałości
      // dla adresata, nie tłumaczenia). Wersja EN dopiero, gdy linia PM na .eu będzie
      // miała realnych czytelników spoza Polski.
      privacy: 'Privacy policy',
      // Regulamin sprzedaży jest polski i taki zostaje, z tego samego powodu co polityka
      // prywatności: sprzedaż konsumencka idzie dziś wyłącznie do polskiego kupującego.
      terms: 'Regulamin sprzedaży',
      // Nota o udziale AI jest polska, tak jak polityka prywatności, i z tego samego powodu:
      // dokument ma być zrozumiały dla adresata, a adresat jest polski.
      ai: 'Jak powstają te teksty',
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {!noHreflang && (
      <Fragment>
        {/* hreflang: DEKLARUJEMY WYŁĄCZNIE PL (03.08.2026).
            Wcześniej para en↔pl wskazywała `krzysztofnyrek.eu` jako angielski odpowiednik tej strony.
            To była nieprawda: pod `.eu` stoi osobny serwis WordPress („Content Writer"), a nie tłumaczenie
            tego huba, więc deklaracja hreflang wprowadzała Google w błąd (a `.eu/about` zwraca 404).
            Link „EN" w nawigacji zostaje jako zwykłe przejście na `.eu` — bez twierdzenia o tłumaczeniu.
            Parę en↔pl przywracamy dopiero, gdy angielski hub realnie zamieszka pod `.eu`. */}
        <link rel="alternate" hreflang="pl" href={HUB_PL + '/'} />
        <link rel="alternate" hreflang="x-default" href={HUB_PL + '/'} />
      </Fragment>
    )}
    <!-- fonty: Google Fonts (Cormorant Garamond + Montserrat) — @import w tokens.css (D79) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#EBF3F9" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isPl ? 'pl_PL' : 'en_US'} />
    <slot name="head" />
    <style>
      html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
      body { overflow-x: hidden; }
      /* .container / .section-pad / scroll-margin są GLOBALNE w tokens.css. */
      .skip-link {
        position: absolute; left: -999px; top: 0; z-index: 100;
        background: var(--navy-600); color: var(--color-white);
        padding: var(--space-sm) var(--space-md); border-radius: var(--radius-sm);
      }
      .skip-link:focus { left: var(--space-md); top: var(--space-md); }
      .nav-links { display: flex; gap: var(--space-lg); flex-wrap: wrap; }
      .nav-cta { font-size: var(--fs-small); }
      /* Mobile nav: chowamy KOTWICE, bo te sekcje da sie osiagnac scrollem.
         🔴 POPRAWKA 25.08.2026: wczesniej znikala CALA lista, razem z linkami do OSOBNYCH STRON,
         a osobnej strony scrollem sie nie osiagnie. Regula z komentarza wyzej byla dobra, jej
         wykonanie za szerokie. Wyszlo przy poleceniu K "podlinkuj z menu" dla /interwencja:
         pozycja byla w kodzie, a na telefonie nie istniala. */
      @media (max-width: 760px) {
        .nav { gap: var(--space-sm); padding-inline: var(--space-md); }
        .nav-link-anchor { display: none; }
        .nav-links { gap: var(--space-md); }
        .nav-cta { padding: 0.65rem 1rem; }
        .nav-logo img { height: 3.5rem; }
      }
      @media (max-width: 420px) {
        /* Na najwezszych ekranach zostaje logo, jedna pozycja strony, flaga i CTA. */
        .nav-links { gap: var(--space-sm); font-size: var(--fs-small); }
      }
      .footer { padding-inline: var(--gutter); }
      .footer-inner { max-width: var(--maxw-content); margin-inline: auto; display: flex; flex-wrap: wrap; gap: var(--space-lg); align-items: center; justify-content: space-between; }
      .footer-meta { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); align-items: baseline; }
    </style>
  </head>
  <body>
    <a href="#hero" class="skip-link">{isPl ? 'Przejdź do treści' : 'Skip to content'}</a>
    <nav class="nav" aria-label={isPl ? 'Główna nawigacja' : 'Main navigation'}>
      <a href="/" class="nav-logo" aria-label="Krzysztof Nyrek">
        <img src="/logo-kn.svg" alt="Krzysztof Nyrek" height="28" />
      </a>
      <span class="nav-spacer"></span>
      <div class="nav-links">
        {nav.links.map((l) => <a class={l.href.startsWith("#") || l.href.startsWith("/#") ? "nav-link nav-link-anchor" : "nav-link nav-link-page"} href={l.href}>{l.label}</a>)}
      </div>
      <a class="nav-flag" href={nav.flagHref} aria-label={isPl ? 'English version' : 'Wersja polska'}>
        {nav.flagLabel}
      </a>
      <a class="btn-primary nav-cta" href={nav.cta.href}>{nav.cta.label}</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a href="#hero" class="footer-logo" aria-label="Krzysztof Nyrek">
          <img src="/logo-kn-navy-bg.svg" alt="Krzysztof Nyrek" height="28" />
        </a>
        <p class="small" style="margin:0; max-width:40ch;">{footer.tagline}</p>
        <div class="footer-meta">
          <span class="caption">© 2026 Krzysztof Nyrek</span>
          <a class="small" href="/polityka-prywatnosci">{footer.privacy}</a>
          <a class="small" href="/regulamin">{footer.terms}</a>
          {footer.returns && <a class="small" href="/polityka-zwrotow">{footer.returns}</a>}
          <a class="small" href="/jak-powstaja-teksty">{footer.ai}</a>
          <a class="small" href={footer.altHref}>{footer.altLabel}</a>
          <a class="small" href="#hero">{footer.home}</a>
        </div>
      </div>
    </footer>
    <Consent />
  </body>
</html>
