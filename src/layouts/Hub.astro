---
// Brand Hub — shared layout (T5/T6). Sticky NAV + flaga PL/EN + stopka + hreflang.
// Prop `lang` ('en'|'pl') steruje nawigacją, flagą i copy stopki. Ta sama identity
// (tokens.css) dla obu; różni się układ/treść sekcji (spec §4A/§4B).
import '../styles/tokens.css';
import { HUB_EN, HUB_PL } from '../config.mjs';

const { lang = 'en', title, description } = Astro.props;
const isPl = lang === 'pl';
const canonical = isPl ? HUB_PL + '/' : HUB_EN + '/';

const nav = isPl
  ? {
      role: 'kierownik-projektu.class / automatyzacja.build',
      links: [
        { href: '#automation', label: 'Automatyzacja' },
        { href: '#learn', label: 'Naucz_się_AI' },
        { href: '#about', label: 'O_mnie' },
      ],
      flagHref: HUB_EN, flag: '🇬🇧', flagLabel: 'EN',
      cta: { href: '#contact', label: 'Kontakt' },
    }
  : {
      role: 'project-manager.class / automation.build',
      links: [
        { href: '#automation', label: 'Automation' },
        { href: '#learn', label: 'Learn_AI' },
        { href: '#blog', label: 'Blog' },
        { href: '#about', label: 'About' },
      ],
      flagHref: HUB_PL, flag: '🇵🇱', flagLabel: 'PL',
      cta: { href: '#contact', label: 'Contact' },
    };

const footer = isPl
  ? {
      tagline: 'Krzysztof Nyrek · Automatyzacja procesów, oparta na praktyce.',
      altHref: HUB_EN, altLabel: 'English',
      home: 'Wróć na górę',
    }
  : {
      tagline: 'Krzysztof Nyrek · Project management, run on AI.',
      altHref: HUB_PL, altLabel: 'Polski',
      home: 'Back to top',
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <!-- hreflang: para hub EN ↔ hub PL (spec §3), x-default = EN. Absolutne domeny produkcyjne. -->
    <link rel="alternate" hreflang="en" href={HUB_EN + '/'} />
    <link rel="alternate" hreflang="pl" href={HUB_PL + '/'} />
    <link rel="alternate" hreflang="x-default" href={HUB_EN + '/'} />
    <!-- fonty self-host: preload wariantów latin above-the-fold (Spec Sheet) -->
    <link rel="preload" href="/fonts/spacegrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plexsans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plexmono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F5F3" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isPl ? 'pl_PL' : 'en_US'} />
    <style>
      html { scroll-behavior: smooth; scroll-padding-top: var(--nav-h); }
      body { overflow-x: hidden; }
      /* .container / .section-pad / scroll-margin są GLOBALNE w tokens.css
         (patrz komentarz tam) — tu były scoped i nie trafiały na komponenty. */
      .skip-link {
        position: absolute; left: -999px; top: 0; z-index: 100;
        background: var(--color-ink); color: var(--color-paper);
        padding: var(--space-sm) var(--space-md); border-radius: var(--radius-sm);
      }
      .skip-link:focus { left: var(--space-md); top: var(--space-md); }
      /* brand: [KN] tag + nazwa (Space Grotesk) + rola (mono) */
      .nav-brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
      .nav-brand-txt { display: flex; flex-direction: column; line-height: 1.15; }
      .nav-brand-name { font-family: var(--font-display); font-weight: 600; font-size: 1rem; letter-spacing: -0.01em; color: var(--text-strong); }
      .nav-brand-role { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-muted); letter-spacing: 0.01em; }
      .nav-links { display: flex; gap: var(--space-lg); flex-wrap: wrap; }
      .nav-cta { font-size: var(--fs-small); }
      /* Mobile nav: sekcje osiągalne scrollem/CTA hero — chowamy listę kotwic + rolę, zostaje [KN] + flaga + CTA */
      @media (max-width: 760px) {
        .nav { gap: var(--space-sm); padding-inline: var(--space-md); }
        .nav-links, .nav-brand-role { display: none; }
        .nav-cta { padding: 0.65rem 1rem; }
      }
      .footer { padding-inline: var(--gutter); }
      .footer-inner { max-width: var(--maxw-content); margin-inline: auto; display: flex; flex-wrap: wrap; gap: var(--space-md) var(--space-lg); align-items: baseline; justify-content: space-between; }
      .footer-meta { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); align-items: baseline; }
    </style>
  </head>
  <body>
    <a href="#hero" class="skip-link">{isPl ? 'Przejdź do treści' : 'Skip to content'}</a>
    <div class="sheet">
    <nav class="nav" aria-label={isPl ? 'Główna nawigacja' : 'Main navigation'}>
      <a href="#hero" class="nav-brand" aria-label="Krzysztof Nyrek">
        <span class="kn-tag" aria-hidden="true">[KN]</span>
        <span class="nav-brand-txt">
          <span class="nav-brand-name">Krzysztof Nyrek</span>
          <span class="nav-brand-role">{nav.role}</span>
        </span>
      </a>
      <span class="nav-spacer"></span>
      <div class="nav-links">
        {nav.links.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
      </div>
      <a class="nav-flag" href={nav.flagHref} aria-label={isPl ? 'English version' : 'Wersja polska'}>
        <span aria-hidden="true">⇄</span> {nav.flagLabel}
      </a>
      <a class="btn-primary nav-cta" href={nav.cta.href}>{nav.cta.label}</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p class="small" style="margin:0; max-width:40ch;">{footer.tagline}</p>
        <div class="footer-meta">
          <span class="caption">© 2026 Krzysztof Nyrek</span>
          <a class="small" href={footer.altHref}>{footer.altLabel}</a>
          <a class="small" href="#hero">{footer.home}</a>
        </div>
      </div>
    </footer>
    </div>
  </body>
</html>
